    "ex":   "https://example.org/ata/",

    "entityType":      { "@id": "ent:entityType",      "@type": "@id" },
    "showAs":          { "@id": "ent:showAs",           "@container": "@language" },
    "href":            { "@id": "ent:href",             "@type": "xsd:anyURI" },
    "label":           { "@id": "rdfs:label",           "@container": "@language" },
    "refersToEntity":  { "@id": "ann:refersToEntity",   "@type": "@id" },
    "hasMention":      { "@id": "ann:hasMention",       "@type": "@id" },
    "mentionOf":       { "@id": "ann:mentionOf",        "@type": "@id" },
    "inElement":       { "@id": "ann:inElement",        "@type": "@id" },
    "surfaceForm":     { "@id": "ann:surfaceForm",      "@container": "@language" },
    "startChar":       { "@id": "ann:startChar",        "@type": "xsd:nonNegativeInteger" },
    "endChar":         { "@id": "ann:endChar",          "@type": "xsd:nonNegativeInteger" },
    "confidence":      { "@id": "ann:confidence",       "@type": "xsd:decimal" },
    "title":           { "@id": "dct:title",            "@container": "@language" },
    "language":        { "@id": "dct:language" },
    "issued":          { "@id": "dct:issued",           "@type": "xsd:date" },
    "expressionOf":    { "@id": "ldso:expressionOf",    "@type": "@id" },
    "hasExpression":   { "@id": "ldso:hasExpression",   "@type": "@id" },
    "contains":        { "@id": "ldso:contains",        "@type": "@id" },
    "partOf":          { "@id": "ldso:partOf",          "@type": "@id" },
    "notation":        { "@id": "ldso:notation" },
    "citation":        { "@id": "ldso:citation" },
    "orderIndex":      { "@id": "ldso:orderIndex",      "@type": "xsd:integer" },
    "text":            { "@id": "ldso:text",            "@container": "@language" },
    "next":            { "@id": "ldso:next",            "@type": "@id" },
    "previous":        { "@id": "ldso:previous",        "@type": "@id" }
  },
  "@graph": [


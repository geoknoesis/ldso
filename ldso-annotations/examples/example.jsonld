    // ── Fine-grained Annotations (NLP output) ────────────────────────────────

    { "@id": "ex:m_tempAdm_p1", "@type": "ann:EntityMention",
      "mentionOf": "ex:temporary_admission", "inElement": "ex:para_1",
      "surfaceForm": { "en": "admitted temporarily" },

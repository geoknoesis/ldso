      "ldso:citation": "2.5.3",
      "ldso:notation": "3",
      "ldso:orderIndex": 3,
      "ldso:partOf": {
        "@id": "ex:art_5"
      },
      "ldso:previous": {
        "@id": "ex:para_2"
      },
      "ldso:text": {
        "@language": "en",
        "@value": "Where the competent authority is satisfied that the conditions\nset out in paragraphs 1 and 2 are fulfilled, it shall grant temporary admission\nby endorsing the presented document and retaining a copy for its records."
      }
    },

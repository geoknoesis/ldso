    { "@id": "ex:m_custTerritory_p1", "@type": "ann:EntityMention",
      "mentionOf": "ex:customs_territory", "inElement": "ex:para_1",
      "surfaceForm": { "en": "customs territory" },
      "startChar": 44, "endChar": 61, "confidence": 0.97 },

    { "@id": "ex:m_tempAdm_p2", "@type": "ann:EntityMention",
      "mentionOf": "ex:temporary_admission", "inElement": "ex:para_2",
      "surfaceForm": { "en": "temporary admission" },
      "startChar": 23, "endChar": 42, "confidence": 0.99 },

    { "@id": "ex:m_compAuth_p2", "@type": "ann:EntityMention",
      "mentionOf": "ex:competent_authority", "inElement": "ex:para_2",
      "surfaceForm": { "en": "competent authority" },
      "startChar": 62, "endChar": 81, "confidence": 0.96 },

    { "@id": "ex:m_compAuth_p3", "@type": "ann:EntityMention",
      "mentionOf": "ex:competent_authority", "inElement": "ex:para_3",
      "surfaceForm": { "en": "competent authority" },
      "startChar": 6, "endChar": 25, "confidence": 0.97 },

    { "@id": "ex:m_ataCarnet_ia", "@type": "ann:EntityMention",
      "mentionOf": "ex:ata_carnet", "inElement": "ex:item_a",
      "surfaceForm": { "en": "ATA carnet" },
      "startChar": 3, "endChar": 13, "confidence": 0.99 },

    // ── Document Structure ────────────────────────────────────────────────────

    { "@id": "ex:resource_ata", "@type": "ldso:LegalResource",
      "title": { "en": "Agreement on Temporary Admission of Goods" },
      "hasExpression": "ex:doc_ata_en" },

    { "@id": "ex:doc_ata_en", "@type": "ldso:Document",
      "title": { "en": "Agreement on Temporary Admission of Goods" },
      "language": "en", "issued": "2026-01-15",
      "expressionOf": "ex:resource_ata", "contains": "ex:body_ata" },

    { "@id": "ex:body_ata", "@type": "ldso:Body",
      "partOf": "ex:doc_ata_en", "contains": "ex:chp_2" },

    { "@id": "ex:chp_2", "@type": "ldso:Chapter",
      "notation": "2", "title": { "en": "Conditions of Temporary Admission" },
      "partOf": "ex:body_ata", "orderIndex": 2, "contains": "ex:art_5" },

    { "@id": "ex:art_5", "@type": "ldso:Article",
      "notation": "5", "citation": "2.5",
      "title": { "en": "Admission Procedures" },
      "partOf": "ex:chp_2", "orderIndex": 5,
      "refersToEntity": ["ex:temporary_admission", "ex:competent_authority"],
      "contains": ["ex:para_1", "ex:para_2", "ex:para_3"] },

    { "@id": "ex:para_1", "@type": "ldso:Paragraph",
      "notation": "1", "citation": "2.5.1", "orderIndex": 1,
      "text": { "en": "Goods shall be admitted temporarily into the customs territory of a Contracting Party without payment of import duties and taxes, provided that they are intended for re-exportation within the period specified in Article 7." },
      "partOf": "ex:art_5",
      "refersToEntity": ["ex:temporary_admission", "ex:customs_territory"],
      "hasMention": ["ex:m_tempAdm_p1", "ex:m_custTerritory_p1"],
      "next": "ex:para_2" },

    { "@id": "ex:para_2", "@type": "ldso:Paragraph",
      "notation": "2", "citation": "2.5.2", "orderIndex": 2,
      "text": { "en": "The applicant for temporary admission shall present to the competent authority one of the following documents:" },
      "partOf": "ex:art_5",
      "refersToEntity": ["ex:temporary_admission", "ex:competent_authority"],
      "hasMention": ["ex:m_tempAdm_p2", "ex:m_compAuth_p2"],
      "previous": "ex:para_1", "next": "ex:para_3", "contains": "ex:list_1" },

    { "@id": "ex:para_3", "@type": "ldso:Paragraph",
      "notation": "3", "citation": "2.5.3", "orderIndex": 3,
      "text": { "en": "Where the competent authority is satisfied that the conditions set out in paragraphs 1 and 2 are fulfilled, it shall grant temporary admission by endorsing the presented document and retaining a copy for its records." },
      "partOf": "ex:art_5",
      "refersToEntity": ["ex:competent_authority"],
      "hasMention": ["ex:m_compAuth_p3"],
      "previous": "ex:para_2" },

    { "@id": "ex:list_1", "@type": "ldso:BlockList",
      "partOf": "ex:para_2",
      "contains": ["ex:item_a", "ex:item_b", "ex:item_c"] },

    { "@id": "ex:item_a", "@type": "ldso:Item",
      "notation": "a", "citation": "2.5.2.a", "orderIndex": 1,
      "text": { "en": "an ATA carnet issued under the terms of this Agreement;" },
      "partOf": "ex:list_1",
      "refersToEntity": ["ex:ata_carnet"],
      "hasMention": ["ex:m_ataCarnet_ia"],
      "next": "ex:item_b" },

    { "@id": "ex:item_b", "@type": "ldso:Item",
      "notation": "b", "citation": "2.5.2.b", "orderIndex": 2,
      "text": { "en": "a national customs document accepted by the competent authority;" },
      "partOf": "ex:list_1", "previous": "ex:item_a", "next": "ex:item_c" },

    { "@id": "ex:item_c", "@type": "ldso:Item",
      "notation": "c", "citation": "2.5.2.c", "orderIndex": 3,
      "text": { "en": "a declaration accepted in accordance with Article 6." },
      "partOf": "ex:list_1", "previous": "ex:item_b" }
  ]
}

      "ldso:citation": "2.5.1",
      "ldso:next": {
        "@id": "ex:para_2"
      },
      "ldso:notation": "1",
      "ldso:orderIndex": 1,
      "ldso:partOf": {
        "@id": "ex:art_5"
      },
      "ldso:text": {
        "@language": "en",
        "@value": "Goods shall be admitted temporarily into the customs territory of\na Contracting Party without payment of import duties and taxes, provided that\nthey are intended for re-exportation within the period specified in Article 7."
      }
    },

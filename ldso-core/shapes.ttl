# ═════════════════════════════════════════════════════════════════════════════
# REFERENCES
# ═════════════════════════════════════════════════════════════════════════════

ldso:ReferenceShape
  a sh:NodeShape ;
  sh:targetClass ldso:Reference ;
  sh:nodeKind sh:IRI ;
  sh:name "Reference" ;
  sh:description "A Reference must point to a target resource via ldso:refersTo or ldso:cites." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "Reference MUST have either ldso:refersTo or ldso:cites." ;
    sh:select """
      PREFIX ldso: <https://w3id.org/ldso/core#>
      SELECT $this WHERE {
        FILTER NOT EXISTS { $this ldso:refersTo ?target }
        FILTER NOT EXISTS { $this ldso:cites ?cited }
      }
    """ ;
  ] .

ldso:InternalReferenceShape
  a sh:NodeShape ;
  sh:targetClass ldso:InternalReference ;
  sh:nodeKind sh:IRI ;
  sh:name "Internal Reference" ;
  sh:description "An InternalReference must point to a target within the same document via ldso:refersTo." ;
  sh:property [
    sh:path ldso:refersTo ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "InternalReference MUST have ldso:refersTo pointing to its target element." ;
  ] .

ldso:ExternalReferenceShape
  a sh:NodeShape ;
  sh:targetClass ldso:ExternalReference ;
  sh:nodeKind sh:IRI ;
  sh:name "External Reference" ;
  sh:description "An ExternalReference must point to a target resource via ldso:refersTo." ;
  sh:property [
    sh:path ldso:refersTo ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "ExternalReference MUST have ldso:refersTo pointing to the referenced external resource." ;
  ] .

ldso:CitationShape
  a sh:NodeShape ;
  sh:targetClass ldso:Citation ;
  sh:nodeKind sh:IRI ;
  sh:name "Citation" ;
  sh:description "A Citation must point to the cited legal resource via ldso:cites." ;
  sh:property [
    sh:path ldso:cites ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "Citation MUST have ldso:cites pointing to the cited legal authority or instrument." ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# CITATION CHAIN CONSISTENCY
# ═════════════════════════════════════════════════════════════════════════════

ldso:CitationChainShape
  a sh:NodeShape ;
  sh:targetSubjectsOf ldso:citation ;
  sh:name "Citation Chain Consistency" ;
  sh:description "A child's ldso:citation must begin with its parent's ldso:citation followed by '.' when both are present." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Citation chain broken: child ldso:citation does not begin with parent ldso:citation followed by '.'." ;
    sh:select """
      PREFIX ldso: <https://w3id.org/ldso/core#>
      SELECT $this ?childCitation ?parentCitation WHERE {
        $this ldso:citation ?childCitation ;
              ldso:partOf ?parent .
        ?parent ldso:citation ?parentCitation .
        FILTER NOT EXISTS {
          FILTER(STRSTARTS(?childCitation, CONCAT(?parentCitation, ".")))
        }
      }
    """ ;
  ] .

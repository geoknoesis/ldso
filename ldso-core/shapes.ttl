  sh:property [
    sh:path ldso:partOf ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Conclusions SHOULD declare ldso:partOf pointing to its Document." ;
  ] .

ldso:ScheduleShape
  a sh:NodeShape ;
  sh:targetClass ldso:Schedule ;
  sh:nodeKind sh:IRI ;
  sh:name "Schedule" ;
  sh:description "A Schedule must have a notation and a title." ;
  sh:property [
    sh:path ldso:notation ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Schedule must have ldso:notation (e.g., 'I', 'II', 'A')." ;
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:message "Schedule must have dct:title (language-tagged)." ;
  ] .

ldso:AppendixShape
  a sh:NodeShape ;
  sh:targetClass ldso:Appendix ;
  sh:nodeKind sh:IRI ;
  sh:name "Appendix" ;
  sh:description "An Appendix must have a notation." ;
  sh:property [
    sh:path ldso:notation ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Appendix must have ldso:notation (e.g., 'A', '1', 'I')." ;
  ] .

ldso:AttachmentShape
  a sh:NodeShape ;
  sh:targetClass ldso:Attachment ;
  sh:nodeKind sh:IRI ;
  sh:name "Attachment" ;
  sh:description "An Attachment should carry a title." ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Warning ;
    sh:message "Attachment SHOULD have dct:title (language-tagged)." ;
  ] .

# ═════════════════════════════════════════════════════════════════════════════
# CLAUSE
# ═════════════════════════════════════════════════════════════════════════════

ldso:ClauseShape
  a sh:NodeShape ;
  sh:targetClass ldso:Clause ;
  sh:nodeKind sh:IRI ;
  sh:name "Clause" ;
  sh:description "A Clause must have a notation." ;
  sh:property [
    sh:path ldso:notation ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Clause must have ldso:notation (e.g., '3', '4.1')." ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# ANNEX
# ═════════════════════════════════════════════════════════════════════════════

ldso:AnnexShape
  a sh:NodeShape ;
  sh:targetClass ldso:Annex ;
  sh:nodeKind sh:IRI ;
  sh:name "Annex" ;
  sh:description "An Annex must have a notation and a title." ;
  sh:property [
    sh:path ldso:notation ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Annex must have ldso:notation (e.g., 'I', 'II', 'A')." ;
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;

  a sh:NodeShape ;
  sh:targetClass ldso:Point ;
  sh:nodeKind sh:IRI ;
  sh:name "Point" ;
  sh:description "A Point must have an orderIndex." ;
  sh:property [
    sh:path ldso:orderIndex ;
    sh:minCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:message "Point must have ldso:orderIndex >= 1." ;
  ] .

ldso:ConclusionsShape
  a sh:NodeShape ;
  sh:targetClass ldso:Conclusions ;
  sh:nodeKind sh:IRI ;
  sh:name "Conclusions" ;

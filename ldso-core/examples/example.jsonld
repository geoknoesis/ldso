      "title":      { "en": "Customs Facilitation" },
      "orderIndex": 2,
      "contains": [
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5" }
      ]
    },

    {
      "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5",
      "@type":      "Article",
      "notation":   "5",
      "citation":   "2.5",
      "title":      { "en": "Temporary Admission of Goods" },
      "orderIndex": 5,
      "contains": [
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_1" },
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2" },
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_3" }
      ],
      "hasTable": [
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1" }
      ]
    },

    {
      "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_1",
      "@type":      "Paragraph",
      "notation":   "1",
      "citation":   "2.5.1",
      "orderIndex": 1,
      "text": {
        "en": "Each Party shall allow the temporary admission of goods referred to in paragraph 2 of this Article without payment of customs duties and taxes."
      },
      "next": { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2" }
    },

    {
      "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2",
      "@type":      "Paragraph",
      "notation":   "2",
      "citation":   "2.5.2",
      "orderIndex": 2,
      "text": {
        "en": "The following goods shall be eligible for temporary admission under this Article:"
      },
      "previous": { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_1" },
      "next":     { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_3" },
      "contains": [
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1" }
      ]
    },

    {
      "@id":    "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1",
      "@type":  "BlockList",
      "contains": [
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_a" },
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_b" },
        { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_c" }
      ]
    },

    {
      "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_a",
      "@type":      "Item",
      "notation":   "a",
      "citation":   "2.5.2.a",
      "orderIndex": 1,
      "text": { "en": "goods for display or demonstration at exhibitions, fairs, or meetings;" },
      "next": { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_b" }
    },

    {
      "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_b",
      "@type":      "Item",
      "notation":   "b",
      "citation":   "2.5.2.b",
      "orderIndex": 2,
      "text": { "en": "professional equipment and tools;" },
      "previous": { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_a" },
      "next":     { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_c" }
    },

    {
      "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_c",
      "@type":      "Item",
      "notation":   "c",
      "citation":   "2.5.2.c",
      "orderIndex": 3,
      "text": { "en": "goods for testing, inspection, or quality control purposes." },
      "previous": { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2/list_1/item_b" }
    },

    {
      "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_3",
      "@type":      "Paragraph",
      "notation":   "3",
      "citation":   "2.5.3",
      "orderIndex": 3,
      "text": {
        "en": "Goods admitted under this Article shall be re-exported within the period specified by the importing Party, which shall not exceed twelve months from the date of admission."
      },
      "previous": { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/para_2" }
    },

    {
      "@id":   "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1",
      "@type": "Table",
      "title": { "en": "Temporary Admission — Applicable Conditions" },
      "hasRow": [
        {
          "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_1",

  "@graph": [

    {
      "@id":   "https://example.org/resource/temporary-admission",
      "@type": "LegalResource",
      "title": { "en": "Agreement on Temporary Admission of Goods" },
      "hasExpression": [
        { "@id": "https://example.org/doc/temporary-admission/EN" }
      ]
    },


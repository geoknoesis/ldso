            { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_1/cell_2", "@type": "Cell", "orderIndex": 2, "text": { "en": "Maximum Period" } },
            { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_1/cell_3", "@type": "Cell", "orderIndex": 3, "text": { "en": "Duty Treatment" } }
          ]
        },
        {
          "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_2",
          "@type":      "Row",
          "orderIndex": 2,
          "previous": { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_1" },
          "next":     { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_3" },
          "hasCell": [
            { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_2/cell_1", "@type": "Cell", "orderIndex": 1, "text": { "en": "Exhibition goods" } },
            { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_2/cell_2", "@type": "Cell", "orderIndex": 2, "text": { "en": "6 months" } },
            { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_2/cell_3", "@type": "Cell", "orderIndex": 3, "text": { "en": "Duty-free" } }
          ]
        },
        {
          "@id":        "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_3",
          "@type":      "Row",
          "orderIndex": 3,

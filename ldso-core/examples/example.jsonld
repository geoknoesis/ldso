            { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_3/cell_2", "@type": "Cell", "orderIndex": 2, "text": { "en": "12 months" } },
            { "@id": "https://example.org/doc/temporary-admission/EN/body/chp_2/art_5/table_1/row_3/cell_3", "@type": "Cell", "orderIndex": 3, "text": { "en": "Duty-free" } }

      "deo:paraphrase": {
        "@language": "en",
        "@value": "The insurer must pay an approved covered claim within 30 days of approval; failing that, it must pay at least the late fee within 10 days. The rule reads the late fee, computed from the recorded claim amount, so without a claimAmount record its obligations are Unknown."
      },
      "deo:strength": {
        "@id": "deo:DefeasibleStrength"
      },

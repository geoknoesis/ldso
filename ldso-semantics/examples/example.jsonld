      },
      "ent:showAs": [
        {
          "@language": "en",
          "@value": "competent authority"
        },
        {
          "@language": "fr",
          "@value": "autorité compétente"
        }
      ]
    },
    {
      "@id": "ex:Exc_TransitGoods",
      "@type": "leg:Exception",
      "leg:annotates": {
        "@id": "ex:para_2"
      },
      "leg:exceptionOf": {
        "@id": "ex:Oblig_Para2_Present"
      },
      "leg:exceptionText": {
        "@language": "en",
        "@value": "Goods in transit through a customs territory under customs\nsupervision are not subject to the presentation requirement of paragraph 2."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Exception: transit goods exempt from documentation requirement"
      }
    },
    {
      "@id": "ex:goods",
      "@type": "ent:Concept",
      "ent:href": {
        "@type": "xsd:anyURI",
        "@value": "https://example.org/legal/concepts/goods"
      },
      "ent:showAs": [
        {
          "@language": "en",
          "@value": "goods"
        },
        {
          "@language": "fr",
          "@value": "marchandises"
        }
      ]
    },
    {
      "@id": "ex:Def_TemporaryAdmission",
      "@type": "leg:Definition",
      "leg:annotates": {
        "@id": "ex:art_1"
      },
      "leg:definedTerm": [
        {
          "@language": "en",
          "@value": "temporary admission"
        },
        {
          "@language": "fr",
          "@value": "admission temporaire"
        }
      ],
      "leg:definesEntity": {
        "@id": "ex:temporary_admission"
      },
      "leg:definitionText": {
        "@language": "en",
        "@value": "The customs procedure under which certain goods can be\nbrought into a customs territory conditionally relieved from payment of\nimport duties and taxes, provided such goods are imported for a specific\npurpose and are intended for re-exportation within a specified period\nwithout having undergone any change except normal depreciation due to the\nuse made of them."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Definition of temporary admission"
      }
    },
    {
      "@id": "ex:Oblig_Para2_Present",
      "@type": "leg:Obligation",
      "leg:annotates": {
        "@id": "ex:para_2"
      },
      "leg:deonticModal": "shall",
      "leg:exceptedBy": {
        "@id": "ex:Exc_TransitGoods"
      },
      "leg:hasScopeAnnotation": {
        "@id": "ex:Scope_Art2_5"
      },
      "leg:normativeObject": {
        "@id": "ex:ata_carnet"
      },
      "leg:normativeSubject": {
        "@id": "ex:applicant"
      },
      "leg:normativeText": {
        "@language": "en",
        "@value": "The applicant for temporary admission shall present to the competent\nauthority one of the following documents: (a) an ATA carnet; (b) a national\ncustoms document; (c) a declaration in accordance with Article 6."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Obligation: present admission document (para 2)"
      }
    },
    {
      "@id": "ex:Discr_ExtendPeriod",
      "@type": "leg:Discretion",
      "leg:annotates": {
        "@id": "ex:art_5"
      },
      "leg:deonticModal": "may",
      "leg:normativeObject": {
        "@id": "ex:temporary_admission"
      },
      "leg:normativeSubject": {
        "@id": "ex:competent_authority"
      },
      "leg:normativeText": {
        "@language": "en",
        "@value": "The competent authority may extend the period of temporary\nadmission beyond the period initially fixed."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Discretion: extend temporary admission period"
      }
    },
    {
      "@id": "ex:item_c",
      "@type": "ldso:Item",
      "ldso:citation": "2.5.2.c",
      "ldso:notation": "c"
    },
    {
      "@id": "ex:Oblig_Para3_Grant",
      "@type": "leg:Obligation",
      "leg:annotates": {
        "@id": "ex:para_3"
      },
      "leg:conditionedBy": {
        "@id": "ex:Cond_SatisfiedConditions"
      },
      "leg:deonticModal": "shall",
      "leg:normativeObject": {
        "@id": "ex:temporary_admission"
      },
      "leg:normativeSubject": {
        "@id": "ex:competent_authority"
      },
      "leg:normativeText": {
        "@language": "en",
        "@value": "Where the competent authority is satisfied that the conditions set\nout in paragraphs 1 and 2 are fulfilled, it shall grant temporary admission\nby endorsing the presented document and retaining a copy for its records."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Obligation: grant temporary admission (para 3)"
      }
    },
    {
      "@id": "ex:item_a",
      "@type": "ldso:Item",
      "ldso:citation": "2.5.2.a",
      "ldso:notation": "a"
    },
    {
      "@id": "ex:para_2",
      "@type": "ldso:Paragraph",
      "ldso:citation": "2.5.2",
      "ldso:notation": "2"
    },
    {
      "@id": "ex:Cond_SatisfiedConditions",
      "@type": "leg:Condition",
      "leg:conditionOf": {
        "@id": "ex:Oblig_Para3_Grant"
      },
      "leg:conditionText": {
        "@language": "en",
        "@value": "The competent authority is satisfied that the conditions set out\nin paragraphs 1 and 2 are fulfilled."
      },
      "leg:statedIn": {
        "@id": "ex:para_3"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Condition: authority satisfied that conditions are fulfilled"
      }
    },
    {
      "@id": "ex:Cond_ReExport",
      "@type": "leg:Condition",
      "leg:conditionOf": {
        "@id": "ex:Oblig_Para1_Admit"
      },
      "leg:conditionText": {
        "@language": "en",
        "@value": "The goods are intended for re-exportation within the period\nspecified in Article 7 without having undergone any change except normal\ndepreciation due to use."
      },
      "leg:statedIn": {
        "@id": "ex:para_1"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Condition: goods intended for re-exportation"
      }
    },
    {
      "@id": "ex:ata_carnet",
      "@type": "ent:Concept",
      "ent:href": {
        "@type": "xsd:anyURI",
        "@value": "https://example.org/legal/concepts/ata-carnet"
      },
      "ent:showAs": [
        {
          "@language": "en",
          "@value": "ATA carnet"
        },
        {
          "@language": "fr",
          "@value": "carnet ATA"
        }
      ]
    },
    {
      "@id": "ex:item_b",
      "@type": "ldso:Item",
      "ldso:citation": "2.5.2.b",
      "ldso:notation": "b"
    },
    {
      "@id": "ex:Oblig_Para1_Admit",
      "@type": "leg:Obligation",
      "leg:annotates": {
        "@id": "ex:para_1"
      },
      "leg:conditionedBy": {
        "@id": "ex:Cond_ReExport"
      },
      "leg:deonticModal": "shall",
      "leg:hasScopeAnnotation": {
        "@id": "ex:Scope_Art2_5"
      },
      "leg:normativeObject": {
        "@id": "ex:goods"
      },
      "leg:normativeSubject": {
        "@id": "ex:contracting_party"
      },
      "leg:normativeText": {
        "@language": "en",
        "@value": "Goods shall be admitted temporarily into the customs territory of\na Contracting Party without payment of import duties and taxes, provided that\nthey are intended for re-exportation within the period specified in Article 7."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Obligation: admit goods temporarily (para 1)"
      }
    },
    {
      "@id": "ex:para_1",
      "@type": "ldso:Paragraph",
      "ldso:citation": "2.5.1",
      "ldso:notation": "1"
    },
    {
      "@id": "ex:para_3",
      "@type": "ldso:Paragraph",
      "ldso:citation": "2.5.3",
      "ldso:notation": "3"
    },
    {
      "@id": "ex:temporary_admission",
      "@type": "ent:Concept",
      "ent:href": {
        "@type": "xsd:anyURI",
        "@value": "https://example.org/legal/concepts/temporary-admission"
      },
      "ent:showAs": [
        {
          "@language": "en",
          "@value": "temporary admission"
        },
        {
          "@language": "fr",
          "@value": "admission temporaire"
        }
      ]
    },
    {
      "@id": "ex:art_5",
      "@type": "ldso:Article",
      "ldso:citation": "2.5",
      "ldso:notation": "5"
    },
    {
      "@id": "ex:Scope_Art2_5",
      "@type": "leg:Scope",
      "leg:annotates": {
        "@id": "ex:art_5"
      },
      "leg:scopeOf": [
        {
          "@id": "ex:Oblig_Para1_Admit"
        },
        {
          "@id": "ex:Oblig_Para2_Present"
        }
      ],
      "leg:scopeText": {
        "@language": "en",
        "@value": "Applies to each Contracting Party with respect to the temporary\nadmission of goods into its customs territory."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Scope of Article 2.5 — Admission Procedures"
      }
    }
  ]
}
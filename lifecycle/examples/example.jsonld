    {
      "@id": "ex:USMCA_Art2_5_Para3_v2",
      "@type": "life:VersionedProvision",
      "dct:description": {
        "@language": "en",
        "@value": "Revised tariff elimination schedule providing for accelerated\nphase-out of tariffs on steel and aluminium products. Tariffs on goods\nclassified under HS Chapters 72 and 76 are eliminated in full by 2030."
      },
      "ldso:partOf": {
        "@id": "ex:USMCA_Art2_5"
      },
      "life:effectiveFrom": {
        "@type": "xsd:date",
        "@value": "2028-03-01"

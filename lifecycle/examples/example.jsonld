    {
      "@id": "ex:Instr_Repeal_BIT_Art12",
      "@type": "life:AmendmentInstruction",
      "dct:source": {
        "@id": "ex:BIT_TerminationProtocol_2025"
      },
      "life:changeDescription": {
        "@language": "en",
        "@value": "Article 12 of the Bilateral Investment Treaty 2015 is hereby\nrepealed with effect from 1 June 2026. Pending arbitrations commenced before\nthat date continue to be governed by Article 12 until their conclusion."
      },
      "life:eventDate": {
        "@type": "xsd:date",
        "@value": "2025-12-01"

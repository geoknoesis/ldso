# ═════════════════════════════════════════════════════════════════════════════
# Comparator
# ═════════════════════════════════════════════════════════════════════════════

ops:ComparatorShape
  a sh:NodeShape ;
  sh:targetClass ops:Comparator ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Violation ;
    sh:message "Comparator MUST have at least one rdfs:label (language-tagged)." ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# PeriodSchedule — start < end (SPARQL)
# ═════════════════════════════════════════════════════════════════════════════

ops:SchedulePeriodOrderShape
  a sh:NodeShape ;
  sh:targetClass ops:PeriodSchedule ;
  sh:nodeKind sh:IRI ;
  sh:name "Period Schedule Ordering" ;
  sh:description "ops:periodStart MUST be strictly earlier than ops:periodEnd." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "ops:periodStart MUST be strictly earlier than ops:periodEnd on a PeriodSchedule." ;
    sh:select """
      PREFIX ops: <https://w3id.org/ldso/operations#>
      SELECT $this WHERE {
        $this ops:periodStart ?start ;
              ops:periodEnd   ?end .
        FILTER (?start >= ?end)
      }
    """ ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# Step — Order Uniqueness (SPARQL)
# ═════════════════════════════════════════════════════════════════════════════

ops:StepOrderUniquenessShape
  a sh:NodeShape ;
  sh:targetClass ops:Step ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "ops:stepOrder MUST be unique within a Procedure — two Steps of the same Procedure share an order value." ;
    sh:select """
      PREFIX ops: <https://w3id.org/ldso/operations#>
      SELECT $this WHERE {
        ?proc ops:hasStep $this ;
              ops:hasStep ?other .
        $this ops:stepOrder ?order .
        ?other ops:stepOrder ?order .
        FILTER ($this != ?other)
      }
    """ ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# Step — nextStep Cycle Detection (SPARQL)
# ═════════════════════════════════════════════════════════════════════════════

ops:NextStepAcyclicShape
  a sh:NodeShape ;
  sh:targetClass ops:Step ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "ops:nextStep chain forms a cycle — a Step directly or indirectly references itself via ops:nextStep." ;
    sh:select """
      PREFIX ops: <https://w3id.org/ldso/operations#>
      SELECT $this WHERE {
        $this ops:nextStep+ $this .
      }
    """ ;
  ] .

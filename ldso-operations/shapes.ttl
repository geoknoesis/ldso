# ═════════════════════════════════════════════════════════════════════════════
# Procedure
# ═════════════════════════════════════════════════════════════════════════════

ops:ProcedureShape
  a sh:NodeShape ;
  sh:targetClass ops:Procedure ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Violation ;
    sh:message "Procedure MUST have at least one rdfs:label." ;
  ] ;

  sh:property [
    sh:path ops:hasStep ;
    sh:minCount 1 ;
    sh:class ops:Step ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "Procedure MUST have at least one Step via ops:hasStep." ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# Step
# ═════════════════════════════════════════════════════════════════════════════

ops:StepShape
  a sh:NodeShape ;
  sh:targetClass ops:Step ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Violation ;
    sh:message "Step MUST have at least one rdfs:label." ;
  ] ;

  sh:property [
    sh:path ops:stepOrder ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:severity sh:Violation ;
    sh:message "Step MUST have exactly one ops:stepOrder (positive integer, 1-based)." ;
  ] ;

  sh:property [
    sh:path ops:stepDescription ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Violation ;
    sh:message "Step MUST have at least one ops:stepDescription (language-tagged)." ;
  ] ;

  sh:property [
    sh:path ops:nextStep ;
    sh:class ops:Step ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "ops:nextStep MUST reference a Step IRI." ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# Schedule
# ═════════════════════════════════════════════════════════════════════════════

ops:ScheduleShape
  a sh:NodeShape ;
  sh:targetClass ops:Schedule ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Violation ;
    sh:message "Schedule MUST have at least one rdfs:label." ;
  ] .

ops:DeadlineShape
  a sh:NodeShape ;
  sh:targetClass ops:Deadline ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "Deadline MUST have at least one of ops:deadlineDate or ops:deadlineDuration." ;
    sh:select """
      PREFIX ops: <https://w3id.org/ldso/operations#>
      SELECT $this WHERE {
        FILTER NOT EXISTS { $this ops:deadlineDate ?d }
        FILTER NOT EXISTS { $this ops:deadlineDuration ?dur }
      }
    """ ;
  ] .

ops:RecurringScheduleShape
  a sh:NodeShape ;
  sh:targetClass ops:RecurringSchedule ;

  sh:property [
    sh:path ops:recurrencePeriod ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
    sh:severity sh:Violation ;
    sh:message "RecurringSchedule MUST have exactly one ops:recurrencePeriod (xsd:duration)." ;
  ] .

ops:PeriodScheduleShape
  a sh:NodeShape ;
  sh:targetClass ops:PeriodSchedule ;

  sh:property [
    sh:path ops:periodStart ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:severity sh:Violation ;
    sh:message "PeriodSchedule MUST have exactly one ops:periodStart." ;
  ] ;

  sh:property [
    sh:path ops:periodEnd ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:severity sh:Violation ;
    sh:message "PeriodSchedule MUST have exactly one ops:periodEnd." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "PeriodSchedule ops:periodEnd MUST be later than ops:periodStart." ;
    sh:select """
      PREFIX ops: <https://w3id.org/ldso/operations#>
      SELECT $this WHERE {
        $this ops:periodStart ?start ;
              ops:periodEnd   ?end .
        FILTER (?end <= ?start)
      }
    """ ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# Measurement
# ═════════════════════════════════════════════════════════════════════════════

ops:MeasurementShape
  a sh:NodeShape ;
  sh:targetClass ops:Measurement ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Violation ;
    sh:message "Measurement MUST have at least one rdfs:label." ;
  ] ;

  sh:property [
    sh:path ops:numericValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:severity sh:Violation ;
    sh:message "Measurement MUST have exactly one ops:numericValue (xsd:decimal)." ;
  ] ;

  sh:property [
    sh:path ops:unit ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:message "Measurement MUST have exactly one ops:unit (xsd:string)." ;
  ] ;

  sh:property [
    sh:path ops:hasComparator ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class ops:Comparator ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "Measurement MUST have exactly one ops:hasComparator pointing to a Comparator named individual." ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════

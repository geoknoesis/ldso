@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ops:  <https://w3id.org/ldso/operations#> .
@prefix leg:  <https://w3id.org/ldso/semantics#> .
@prefix ent:  <https://w3id.org/ldso/entities#> .

# ─────────────────────────────────────────────────────────────────────────────
# LDSO-Operations SHACL Shapes
# ─────────────────────────────────────────────────────────────────────────────

<https://w3id.org/ldso/operations/shapes>
  a owl:Ontology ;
  dct:title "LDSO-Operations SHACL Validation Shapes"@en ;
  dct:description "SHACL node shapes for validating instances of LDSO-Operations classes."@en ;
  owl:imports <https://w3id.org/ldso/operations> .


# ═════════════════════════════════════════════════════════════════════════════
# OperativeRule
# ═════════════════════════════════════════════════════════════════════════════

ops:OperativeRuleShape
  a sh:NodeShape ;
  sh:targetClass ops:OperativeRule ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Violation ;
    sh:message "OperativeRule MUST have at least one rdfs:label (language-tagged)." ;
  ] ;

  sh:property [
    sh:path ops:hasTrigger ;
    sh:minCount 1 ;
    sh:class ops:Trigger ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "OperativeRule MUST reference at least one Trigger via ops:hasTrigger." ;
  ] ;

  sh:property [
    sh:path ops:operativizes ;
    sh:minCount 1 ;
    sh:class leg:NormativeStatement ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Warning ;
    sh:message "OperativeRule SHOULD reference the NormativeStatement it implements via ops:operativizes." ;
  ] ;

  sh:property [
    sh:path ops:hasProcedure ;
    sh:maxCount 1 ;
    sh:class ops:Procedure ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "OperativeRule MUST NOT reference more than one Procedure via ops:hasProcedure." ;
  ] ;

  sh:property [
    sh:path ops:hasCriterion ;
    sh:class ops:Criterion ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "ops:hasCriterion values MUST be IRI references to Criterion instances." ;
  ] ;

  sh:property [
    sh:path ops:hasSchedule ;
    sh:class ops:Schedule ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "ops:hasSchedule values MUST be IRI references to Schedule instances." ;
  ] .


# ═════════════════════════════════════════════════════════════════════════════
# Trigger
# ═════════════════════════════════════════════════════════════════════════════

ops:TriggerShape
  a sh:NodeShape ;
  sh:targetClass ops:Trigger ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:severity sh:Violation ;
    sh:message "Trigger MUST have at least one rdfs:label (language-tagged)." ;
  ] .

ops:ThresholdTriggerShape
  a sh:NodeShape ;
  sh:targetClass ops:ThresholdTrigger ;

  sh:property [
    sh:path ops:hasMeasurement ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class ops:Measurement ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "ThresholdTrigger MUST have exactly one ops:hasMeasurement." ;
  ] .



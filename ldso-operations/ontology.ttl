ops:Measurement               rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:Comparator                rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:Equal                     rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:NotEqual                  rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:LessThan                  rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:LessThanOrEqual           rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:GreaterThan               rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:GreaterThanOrEqual        rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:DocumentaryRequirement    rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:operativizes              rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:hasTrigger                rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:hasCriterion              rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:hasProcedure              rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:hasStep                   rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:nextStep                  rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:hasSchedule               rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:hasDocumentaryRequirement rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:requiresDocument          rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:hasMeasurement            rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:hasComparator             rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:performedBy               rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:appliesTo                 rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:triggerDescription        rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:criterionDescription      rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:stepOrder                 rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:stepDescription           rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:numericValue              rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
ops:unit                      rdfs:isDefinedBy <https://w3id.org/ldso/operations> .
